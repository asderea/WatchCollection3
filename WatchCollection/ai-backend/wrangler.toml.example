name = "watch-collection-ai"
main = "worker.js"
compatibility_date = "2026-11-01"

[vars]
OPENAI_MODEL = "gpt-6-luna"
OPENAI_SERVICE_TIER = "default"

# 첫 지급분의 실제 값과 이후 정상 월 지급액으로 교체합니다.
# OPENAI_CREDIT_RECURRING_TOTAL_USD를 설정하면 첫 만료 직후부터 월별로 자동 갱신됩니다.
OPENAI_CREDIT_TOTAL_USD = "REPLACE_WITH_FIRST_GRANT_AMOUNT"
OPENAI_CREDIT_START_AT = "REPLACE_WITH_FIRST_GRANT_START_TIME"
OPENAI_CREDIT_EXPIRES_AT = "REPLACE_WITH_FIRST_GRANT_EXPIRY_TIME"
OPENAI_CREDIT_RECURRING_TOTAL_USD = "REPLACE_WITH_NORMAL_MONTHLY_GRANT_AMOUNT"

# 지급액을 거의 모두 사용하되, 비용 집계 지연에 따른 초과 결제를 줄이기 위한 보호값입니다.
OPENAI_CREDIT_GUARD_ENABLED = "true"
OPENAI_CREDIT_RESERVE_USD = "0.00"
OPENAI_SPEC_REQUEST_RESERVE_USD = "0.05"
OPENAI_RECOMMEND_REQUEST_RESERVE_USD = "0.01"
OPENAI_USAGE_CACHE_SECONDS = "60"

# 실제 Credit grants 잔여량에 가깝게 계산하려면 조직 전체 비용을 합산하도록 비워 둡니다.
# 특정 Watch Collection 프로젝트 비용만 보려는 경우에만 아래 주석을 해제합니다.
# OPENAI_PROJECT_ID = "proj_..."
